{
  "schema_version": 2,
  "required_capabilities": [
    "declarative_basic"
  ],
  "pages": [
    {
      "id": "dashboard",
      "title": "炒币模拟器",
      "description": "模拟钱包投资仪表盘：资产、持仓、合约、成交、资产曲线、历史回放与决策日志",
      "icon": "chart",
      "mode": "declarative",
      "auto_refresh": true,
      "poll_interval_seconds": 30,
      "queries": {
        "dash": {
          "api": "get_dashboard",
          "version": "1",
          "parameters": {}
        },
        "journal": {
          "api": "get_journal",
          "version": "1",
          "parameters": {
            "limit": {
              "type": "integer",
              "required": false,
              "minimum": 1,
              "maximum": 200
            },
            "kind": {
              "type": "string",
              "required": false,
              "choices": [
                "all",
                "llm",
                "command",
                "system"
              ]
            }
          }
        },
        "replay_status": {
          "api": "get_replay_status",
          "version": "1",
          "parameters": {}
        }
      },
      "actions": {
        "do_replay": {
          "api": "run_replay",
          "version": "1",
          "parameters": {
            "preset": {
              "type": "string",
              "required": true,
              "choices": [
                "day",
                "week",
                "month",
                "quarter",
                "year"
              ]
            },
            "until": {
              "type": "string",
              "required": false,
              "max_length": 20
            }
          }
        },
        "do_reset": {
          "api": "reset_wallet",
          "version": "1",
          "parameters": {},
          "confirmation": "确定重置钱包吗？所有持仓、仓位、成交与曲线记录将清空，恢复初始资金。"
        }
      },
      "content": [
        {
          "type": "text",
          "label": "数据时间",
          "value": {
            "source": "dash",
            "field": "updated_at",
            "scope": "query"
          }
        },
        {
          "type": "grid",
          "columns": 4,
          "label": "资产总览",
          "children": [
            {
              "type": "stat",
              "label": "总资产 (USDT)",
              "value": {
                "source": "dash",
                "field": "overview.total",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "总盈亏 (USDT)",
              "value": {
                "source": "dash",
                "field": "overview.pnl",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "收益率",
              "value": {
                "source": "dash",
                "field": "overview.pnl_pct",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "可用现金",
              "value": {
                "source": "dash",
                "field": "overview.cash",
                "scope": "query"
              }
            }
          ]
        },
        {
          "type": "grid",
          "columns": 4,
          "label": "资金构成",
          "children": [
            {
              "type": "stat",
              "label": "现货市值",
              "value": {
                "source": "dash",
                "field": "overview.spot_value",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "现货浮盈",
              "value": {
                "source": "dash",
                "field": "overview.spot_upnl",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "合约保证金",
              "value": {
                "source": "dash",
                "field": "overview.margin",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "合约浮盈",
              "value": {
                "source": "dash",
                "field": "overview.fut_upnl",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "已实现盈亏",
              "value": {
                "source": "dash",
                "field": "overview.realized_pnl",
                "scope": "query"
              }
            }
          ]
        },
        {
          "type": "chart",
          "label": "资产曲线 (USDT)",
          "value": {
            "source": "dash",
            "field": "curve",
            "scope": "query"
          },
          "chart_type": "line",
          "x": "t",
          "y": "v"
        },
        {
          "type": "table",
          "label": "现货持仓",
          "value": {
            "source": "dash",
            "field": "spot",
            "scope": "query"
          },
          "columns": [
            {
              "field": "symbol",
              "label": "币种"
            },
            {
              "field": "qty",
              "label": "数量"
            },
            {
              "field": "avg_cost",
              "label": "成本"
            },
            {
              "field": "price",
              "label": "现价"
            },
            {
              "field": "value",
              "label": "市值"
            },
            {
              "field": "upnl",
              "label": "浮盈"
            },
            {
              "field": "upnl_pct",
              "label": "浮盈%"
            },
            {
              "field": "tp",
              "label": "止盈"
            },
            {
              "field": "sl",
              "label": "止损"
            }
          ]
        },
        {
          "type": "table",
          "label": "合约仓位",
          "value": {
            "source": "dash",
            "field": "futures",
            "scope": "query"
          },
          "columns": [
            {
              "field": "symbol",
              "label": "币种"
            },
            {
              "field": "side",
              "label": "方向"
            },
            {
              "field": "qty",
              "label": "数量"
            },
            {
              "field": "leverage",
              "label": "杠杆"
            },
            {
              "field": "entry",
              "label": "开仓价"
            },
            {
              "field": "price",
              "label": "标记价"
            },
            {
              "field": "liq",
              "label": "爆仓价"
            },
            {
              "field": "margin",
              "label": "保证金"
            },
            {
              "field": "upnl",
              "label": "浮盈"
            },
            {
              "field": "upnl_pct",
              "label": "收益率%"
            },
            {
              "field": "tp",
              "label": "止盈"
            },
            {
              "field": "sl",
              "label": "止损"
            }
          ]
        },
        {
          "type": "table",
          "label": "最近成交",
          "value": {
            "source": "dash",
            "field": "trades",
            "scope": "query"
          },
          "columns": [
            {
              "field": "time",
              "label": "时间"
            },
            {
              "field": "action",
              "label": "操作"
            },
            {
              "field": "symbol",
              "label": "币种"
            },
            {
              "field": "qty",
              "label": "数量"
            },
            {
              "field": "price",
              "label": "价格"
            },
            {
              "field": "amount",
              "label": "金额"
            },
            {
              "field": "pnl",
              "label": "盈亏"
            }
          ]
        },
        {
          "type": "grid",
          "columns": 4,
          "label": "快捷操作",
          "children": [
            {
              "type": "select",
              "name": "preset",
              "label": "回放时段",
              "value": "week",
              "options": [
                {
                  "label": "最近1天（1h×24）",
                  "value": "day"
                },
                {
                  "label": "最近1周（1h×168）",
                  "value": "week"
                },
                {
                  "label": "最近1月（4h×180）",
                  "value": "month"
                },
                {
                  "label": "最近1季（4h×540）",
                  "value": "quarter"
                },
                {
                  "label": "最近1年（1d×365）",
                  "value": "year"
                }
              ]
            },
            {
              "type": "date",
              "name": "until",
              "label": "回放截止日（可选）"
            },
            {
              "type": "button",
              "label": "🎬 开始历史回放",
              "action": "do_replay",
              "variant": "primary"
            },
            {
              "type": "button",
              "label": "🔄 重置钱包",
              "action": "do_reset",
              "variant": "danger"
            }
          ]
        },
        {
          "type": "grid",
          "columns": 3,
          "label": "统计",
          "children": [
            {
              "type": "stat",
              "label": "LLM 决策",
              "value": {
                "source": "journal",
                "field": "counts.llm",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "命令调用",
              "value": {
                "source": "journal",
                "field": "counts.command",
                "scope": "query"
              }
            },
            {
              "type": "stat",
              "label": "后台事件",
              "value": {
                "source": "journal",
                "field": "counts.system",
                "scope": "query"
              }
            }
          ]
        },
        {
          "type": "select",
          "name": "kind",
          "label": "类型筛选（选择即刷新）",
          "value": "all",
          "options": [
            {
              "label": "全部",
              "value": "all"
            },
            {
              "label": "LLM 决策",
              "value": "llm"
            },
            {
              "label": "命令调用",
              "value": "command"
            },
            {
              "label": "后台事件",
              "value": "system"
            }
          ]
        },
        {
          "type": "table",
          "label": "事件流水",
          "value": {
            "source": "journal",
            "field": "entries",
            "scope": "query"
          },
          "selection": "ev",
          "detail": "ev_detail",
          "columns": [
            {
              "field": "time",
              "label": "时间"
            },
            {
              "field": "kind",
              "label": "类型"
            },
            {
              "field": "title",
              "label": "事件"
            },
            {
              "field": "detail",
              "label": "内容"
            }
          ]
        },
        {
          "type": "dialog",
          "name": "ev_detail",
          "label": "事件详情",
          "children": [
            {
              "type": "text",
              "label": "时间",
              "value": {
                "source": "ev",
                "field": "time",
                "scope": "selection"
              }
            },
            {
              "type": "text",
              "label": "类型",
              "value": {
                "source": "ev",
                "field": "kind",
                "scope": "selection"
              }
            },
            {
              "type": "text",
              "label": "事件",
              "value": {
                "source": "ev",
                "field": "title",
                "scope": "selection"
              }
            },
            {
              "type": "text",
              "label": "LLM 思考",
              "value": {
                "source": "ev",
                "field": "reasoning",
                "scope": "selection"
              }
            },
            {
              "type": "text",
              "label": "内容",
              "value": {
                "source": "ev",
                "field": "detail",
                "scope": "selection"
              }
            }
          ]
        }
      ]
    }
  ]
}